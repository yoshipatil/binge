generator client {
  provider        = "prisma-client-js"
  output          = "../src/generated/prisma"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

// Your ratings — one row per user per movie/show they've watched and scored
model Rating {
  id        String   @id @default(cuid())
  userId    String   @default("")   // Google sub ID from Auth.js session
  tmdbId    Int
  mediaType String   // "movie" | "tv" | "documentary"
  seedScore Float
  eloScore  Float    @default(1000)
  review    String?  @db.Text
  watchedAt DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, tmdbId, mediaType])
  @@index([userId, mediaType])
}

// Watchlist — movies/shows a user wants to see
model Watchlist {
  id        String   @id @default(cuid())
  userId    String   @default("")
  tmdbId    Int
  mediaType String
  addedAt   DateTime @default(now())

  @@unique([userId, tmdbId, mediaType])
  @@index([userId])
}

// Head-to-head comparisons — "did you prefer X over Y?"
model Comparison {
  id           String   @id @default(cuid())
  userId       String   @default("")
  winnerTmdbId Int
  loserTmdbId  Int
  mediaType    String
  createdAt    DateTime @default(now())

  @@index([userId, mediaType])
}

// Cached user profiles — synced from Google on every sign-in.
// Needed because Auth.js JWT strategy has no built-in user table.
// Enables user search, profile pages, and follow relationships.
model User {
  id        String   @id   // Google sub ID (stable across sessions)
  name      String?
  email     String?
  image     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
}

// Follow relationships — follower follows following.
// Used to compute friends' aggregate scores on movie pages
// and to build the activity feed (future).
model Follow {
  id          String   @id @default(cuid())
  followerId  String   // the user doing the following
  followingId String   // the user being followed
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}
